{
  "app": {
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "release"
      }
    ],
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "AppScope/debug.p12",
          "storePassword": "REPLACE_WITH_LOCAL_PASSWORD",
          "keyAlias": "REPLACE_WITH_LOCAL_ALIAS",
          "keyPassword": "REPLACE_WITH_LOCAL_KEY_PASSWORD",
          "signAlg": "SHA256withECDSA",
          "profile": "AppScope/debug.mobileprovision",
          "certpath": "AppScope/debug.cer"
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
